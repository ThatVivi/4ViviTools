root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.cs]
dotnet_diagnostic.CS8602.severity = warning
dotnet_diagnostic.CS8618.severity = warning
dotnet_diagnostic.CA1822.severity = suggestion

[*.{axaml,xaml,csproj,props,yml,yaml,json}]
indent_size = 2
