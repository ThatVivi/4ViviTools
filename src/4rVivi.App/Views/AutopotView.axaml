<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FourRVivi.App.ViewModels"
             xmlns:ctrl="clr-namespace:FourRVivi.App.Controls"
             x:Class="FourRVivi.App.Views.AutopotView"
             x:DataType="vm:AutopotViewModel"
             x:Name="Root">

  <StackPanel Spacing="14">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Spacing="3">
        <TextBlock Text="Auto Potions" Classes="h1"/>
        <TextBlock Classes="muted" Text="RO-style HP/SP potion rules. Record the item hotkey, choose HP or SP, then set the percentage trigger."/>
      </StackPanel>
      <ToggleSwitch Grid.Column="1" Content="Autopot ON" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
    </Grid>

    <Button Classes="accent" Command="{Binding AddPotCommand}" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" Spacing="7">
        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xECC8;" VerticalAlignment="Center"/>
        <TextBlock Text="Add potion rule" VerticalAlignment="Center"/>
      </StackPanel>
    </Button>

    <Border Padding="10,6" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource Surface2Brush}">
      <TextBlock Text="-1 = Auto. Leave React and Delay at -1 for adaptive timing, or enter your own milliseconds." TextWrapping="Wrap"/>
    </Border>

    <Grid ColumnDefinitions="54,82,92,118,118,118,54" Margin="14,0,14,-4">
      <TextBlock Grid.Column="0" Text="Use" Classes="muted"/>
      <TextBlock Grid.Column="1" Text="Hotkey" Classes="muted"/>
      <TextBlock Grid.Column="2" Text="Pool" Classes="muted"/>
      <TextBlock Grid.Column="3" Text="Use at %" Classes="muted"/>
      <TextBlock Grid.Column="4" Text="React (-1 auto)" Classes="muted"/>
      <TextBlock Grid.Column="5" Text="Delay (-1 auto)" Classes="muted"/>
    </Grid>

    <ItemsControl ItemsSource="{Binding Pots}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:PotRowViewModel">
          <Border Classes="card" Margin="0,0,0,8">
            <Grid ColumnDefinitions="54,82,92,118,118,118,54" VerticalAlignment="Center">
              <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" Content="On" VerticalAlignment="Center"/>
              <ctrl:KeyCaptureBox Grid.Column="1" Width="68" KeyText="{Binding Key}"/>
              <ToggleSwitch Grid.Column="2" OffContent="HP" OnContent="SP" IsChecked="{Binding UseSp}" VerticalAlignment="Center"/>
              <NumericUpDown Grid.Column="3" MinWidth="110" Minimum="1" Maximum="100" Value="{Binding Percent}"/>
              <NumericUpDown Grid.Column="4" MinWidth="110" Minimum="-1" Maximum="5000" Value="{Binding ReactionMs}"/>
              <NumericUpDown Grid.Column="5" MinWidth="110" Minimum="-1" Maximum="60000" Value="{Binding UseDelayMs}"/>
              <Button Grid.Column="6" Content="X" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Command="{ReflectionBinding DataContext.RemovePotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
