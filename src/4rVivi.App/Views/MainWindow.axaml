<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FourRVivi.App.ViewModels"
        xmlns:game="clr-namespace:FourRVivi.Core.Game;assembly=4rVivi.Core"
        x:Class="FourRVivi.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1600" Height="900" MinWidth="900" MinHeight="600"
        Title="4rVivi" Background="{DynamicResource BgBrush}"
        Opacity="{Binding WindowOpacity}"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="56,Auto,*">

    <!-- top bar -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" VerticalAlignment="Center" Margin="14,0">
        <TextBlock Grid.Column="0" Text="4ViviTools" Foreground="{DynamicResource AccentBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/>
        <TextBlock Grid.Column="1" Text="Process" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox Grid.Column="2" Width="240" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="game:GameProcess"><TextBlock Text="{Binding Display}"/></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="3" Margin="6,0,0,0" Command="{Binding RefreshProcessesCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" VerticalAlignment="Center"/>
            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Profile" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox Width="140" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"/>
        </StackPanel>
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="HP" Classes="muted" VerticalAlignment="Center"/>
          <ProgressBar Width="70" Minimum="0" Maximum="100" Value="{Binding HpPercent}" Foreground="{DynamicResource DangerBrush}"/>
          <TextBlock Text="{Binding HpText}" VerticalAlignment="Center" MinWidth="56"/>
          <TextBlock Text="SP" Classes="muted" VerticalAlignment="Center" Margin="6,0,0,0"/>
          <ProgressBar Width="70" Minimum="0" Maximum="100" Value="{Binding SpPercent}" Foreground="{DynamicResource Accent2Brush}"/>
          <TextBlock Text="{Binding SpText}" VerticalAlignment="Center" MinWidth="56"/>
        </StackPanel>
        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="Opacity" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <Slider Width="110" Minimum="0.15" Maximum="1.0" Value="{Binding WindowOpacity}" VerticalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Column="7" MinWidth="132" Command="{Binding StopAllCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" VerticalAlignment="Center"/>
            <TextBlock Text="Stop all (F12)" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- horizontal category nav (moved from the left rail) -->
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Categories}" Margin="10,5">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:NavCategory">
              <RadioButton Classes="nav" GroupName="cat"
                           IsChecked="{Binding IsActive, Mode=TwoWay}" Command="{Binding SelectCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding Icon}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                </StackPanel>
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- body (full width) -->
    <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto">
      <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding CurrentCategory.Pages}" Margin="10,5">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:NavPage">
                  <RadioButton Classes="nav" GroupName="subtab"
                               IsChecked="{Binding IsActive, Mode=TwoWay}" Command="{Binding SelectCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding Icon}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <ToggleSwitch Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center"
                        OnContent="Tool ON" OffContent="Tool OFF"
                        IsVisible="{Binding CurrentCategory.Togglable}"
                        IsChecked="{Binding CurrentCategory.Enabled}"/>
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1">
        <ContentControl Content="{Binding CurrentPage}" Margin="22"/>
      </ScrollViewer>
      <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,7">
        <TextBlock Text="{Binding StatusText}" Classes="muted"/>
      </Border>
    </Grid>
  </Grid>
</Window>
