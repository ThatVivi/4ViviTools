<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FourRVivi.App.ViewModels"
             x:Class="FourRVivi.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <StackPanel Spacing="16">
    <TextBlock Text="4rVivi Dashboard" Classes="h1"/>

    <Border Classes="card" Background="{DynamicResource Surface2Brush}">
      <StackPanel Spacing="10">
        <TextBlock Text="Start here" Classes="section"/>
        <TextBlock Text="{Binding OcrStatus}" TextWrapping="Wrap" FontWeight="SemiBold"/>
        <Button Classes="accent" Content="Open OCR Reader" Command="{Binding OpenOcrCommand}" HorizontalAlignment="Left"/>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Text="Main controls" Classes="section"/>
        <WrapPanel>
          <ToggleSwitch Content="Smart Bot" IsChecked="{Binding SmartBot.Enabled}" Margin="0,0,18,6"/>
          <ToggleSwitch Content="Autopot" IsChecked="{Binding Autopot.Enabled}" Margin="0,0,18,6"/>
          <ToggleSwitch Content="Buffs" IsChecked="{Binding Buffs.Enabled}" Margin="0,0,18,6"/>
          <ToggleSwitch Content="RCX Overlay" IsChecked="{Binding Overlay.Enabled}" Margin="0,0,18,6"/>
          <ToggleSwitch Content="Macros" IsChecked="{Binding Macros.Enabled}" Margin="0,0,18,6"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <TextBlock Classes="section" Text="QUICK OPEN"/>
    <WrapPanel>
      <Button Content="Smart Bot" Margin="0,0,8,8" Command="{Binding GoCommand}" CommandParameter="Smart Bot"/>
      <Button Content="Multi Client" Margin="0,0,8,8" Command="{Binding GoCommand}" CommandParameter="Multi Client"/>
      <Button Content="OCR Reader" Margin="0,0,8,8" Command="{Binding GoCommand}" CommandParameter="OCR Reader"/>
      <Button Content="Overlay" Margin="0,0,8,8" Command="{Binding GoCommand}" CommandParameter="Overlay"/>
      <Button Content="Buff HUD" Margin="0,0,8,8" Command="{Binding GoCommand}" CommandParameter="Buff HUD"/>
      <Button Content="Loot Log" Margin="0,0,8,8" Command="{Binding GoCommand}" CommandParameter="Loot Log"/>
      <Button Content="Calculator" Margin="0,0,8,8" Command="{Binding GoCommand}" CommandParameter="Calculator"/>
      <Button Content="Database" Margin="0,0,8,8" Command="{Binding GoCommand}" CommandParameter="Database"/>
      <Button Content="Settings" Margin="0,0,8,8" Command="{Binding GoCommand}" CommandParameter="Settings"/>
    </WrapPanel>
  </StackPanel>
</UserControl>
