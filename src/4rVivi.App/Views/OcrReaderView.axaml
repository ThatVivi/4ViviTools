<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FourRVivi.App.ViewModels"
             xmlns:ocr="clr-namespace:FourRVivi.Core.Ocr;assembly=4rVivi.Core"
             xmlns:conv="clr-namespace:FourRVivi.App.Converters"
             x:Class="FourRVivi.App.Views.OcrReaderView" x:DataType="vm:OcrReaderViewModel">
  <UserControl.Resources>
    <conv:RoleToBrushConverter x:Key="RoleToBrush"/>
  </UserControl.Resources>
  <Grid ColumnDefinitions="*,300" Margin="4">
    <StackPanel Grid.Column="0" Spacing="10">
      <TextBlock Text="OCR Reader (screen-based, Gepard-proof)" Classes="h1"/>
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Paste a screenshot with Ctrl+V (or Load it). Pick a stat, then drag a box over it on the image — each role has its own colour. Save. Press Start — it reads those spots off the live window non-stop and feeds the top bar, Stats and Discord. It can't get map/coords (RO doesn't show them)."/>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Classes="accent" Content="Load screenshot" Click="OnLoadClick"/>
        <Button Content="Paste image" Click="OnPasteClick"/>
        <TextBlock Text="Marking as:" Classes="muted" VerticalAlignment="Center"/>
        <ComboBox Width="140" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"/>
      </StackPanel>
      <Border Classes="card" Padding="0" HorizontalAlignment="Left">
        <Canvas x:Name="DrawCanvas" Background="{DynamicResource Surface2Brush}" Width="720" Height="405" ClipToBounds="True">
          <Image x:Name="Img" Stretch="Fill"/>
        </Canvas>
      </Border>
    </StackPanel>

    <StackPanel Grid.Column="1" Spacing="10" Margin="12,0,0,0">
      <TextBlock Text="Marks" Classes="section"/>
      <Border Classes="card" Padding="0" Height="240">
        <ListBox ItemsSource="{Binding Marks}" Background="Transparent"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="ocr:OcrMark">
              <Grid ColumnDefinitions="16,*,28">
                <Rectangle Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center" Fill="{Binding Role, Converter={StaticResource RoleToBrush}}"/>
                <TextBlock Grid.Column="1" Text="{Binding Role}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <Button Grid.Column="2" Content="✕"
                        Command="{ReflectionBinding DataContext.RemoveMarkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="Refresh ms" Classes="muted" VerticalAlignment="Center"/>
        <NumericUpDown Width="110" Minimum="120" Maximum="2000" Increment="50" Value="{Binding IntervalMs}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Save" Command="{Binding SaveCommand}"/>
        <Button Content="Clear" Command="{Binding ClearMarksCommand}"/>
        <Button Classes="accent" Content="Start" Command="{Binding StartCommand}" IsVisible="{Binding !Running}"/>
        <Button Classes="accent" Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding Running}"/>
      </StackPanel>
      <TextBlock Text="Live readout" Classes="section"/>
      <Border Classes="card" Padding="0" Height="180">
        <ListBox ItemsSource="{Binding LiveReadout}" Background="Transparent" FontFamily="Consolas,monospace"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
      </Border>
      <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>
</UserControl>
