<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FourRVivi.App.ViewModels"
             x:Class="FourRVivi.App.Views.MvpTrackerView" x:DataType="vm:MvpTrackerViewModel" x:Name="Root">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
    <TextBlock Grid.Row="0" Text="MVP Tracker" Classes="h1"/>

    <!-- Add from dropdown -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
      <TextBlock Text="MVP" Classes="muted" VerticalAlignment="Center"/>
      <ComboBox Width="240" ItemsSource="{Binding MvpChoices}" SelectedItem="{Binding SelectedChoice}"/>
      <Button Classes="accent" Content="Add" Command="{Binding AddSelectedCommand}"/>
      <Button Content="Download icons" Command="{Binding DownloadIconsCommand}"/>
      <Button Content="Clear all" Command="{Binding ClearCommand}"/>
    </StackPanel>

    <!-- Add custom -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8">
      <TextBlock Text="Custom:" Classes="muted" VerticalAlignment="Center"/>
      <TextBox Width="180" Text="{Binding NewName}" Watermark="name"/>
      <TextBox Width="150" Text="{Binding NewMap}" Watermark="map"/>
      <NumericUpDown MinWidth="92" Minimum="1" Maximum="100000" Value="{Binding NewMin}"/>
      <TextBlock Text="~" VerticalAlignment="Center"/>
      <NumericUpDown MinWidth="92" Minimum="1" Maximum="100000" Value="{Binding NewMax}"/>
      <Button Content="+ Add custom" Command="{Binding AddCustomCommand}"/>
    </StackPanel>

    <TextBlock Grid.Row="3" Classes="muted" Text="{Binding Status}" Margin="0,8"/>

    <!-- Two columns: catalog (left) | ranked respawn timers (right) -->
    <Grid Grid.Row="4" ColumnDefinitions="*,12,380">
      <Border Grid.Column="0" Classes="card" Padding="0">
        <ListBox ItemsSource="{Binding Entries}" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MvpRowViewModel">
              <Grid ColumnDefinitions="40,16,*,150,Auto,Auto,Auto,Auto" VerticalAlignment="Center" Height="54" Margin="2">
                <Image Grid.Column="0" Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform"/>
                <Ellipse Grid.Column="1" Width="12" Height="12" VerticalAlignment="Center" Fill="{Binding StatusBrush}" ToolTip.Tip="{Binding Status}"/>
                <StackPanel Grid.Column="2" Margin="8,0" VerticalAlignment="Center">
                  <TextBox Text="{Binding Name}"/>
                  <TextBlock Text="{Binding BestElement}" Foreground="#7CC4FF" FontSize="10"/>
                </StackPanel>
                <TextBox Grid.Column="3" Text="{Binding Map}" Watermark="map" Margin="0,0,8,0"/>
                <NumericUpDown Grid.Column="4" MinWidth="92" Minimum="1" Maximum="100000" Value="{Binding MinMinutes}" Margin="0,0,4,0"/>
                <TextBlock Grid.Column="5" Text="~" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <NumericUpDown Grid.Column="6" MinWidth="92" Minimum="1" Maximum="100000" Value="{Binding MaxMinutes}" Margin="0,0,8,0"/>
                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6">
                  <Button Classes="accent" Content="Killed"
                          Command="{ReflectionBinding DataContext.RegisterKillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                  <Button Content="↗" ToolTip.Tip="Open on divine-pride"
                          Command="{ReflectionBinding DataContext.OpenDpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                  <Button Content="✕"
                          Command="{ReflectionBinding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="2" Classes="card" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="Respawn timers (soonest first)" Classes="section" Margin="10,8"/>
          <ListBox Grid.Row="1" ItemsSource="{Binding Active}" Background="Transparent"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MvpRowViewModel">
                <Grid ColumnDefinitions="36,14,*,Auto" VerticalAlignment="Center" Height="40" Margin="4,2">
                  <Image Grid.Column="0" Source="{Binding Icon}" Width="28" Height="28" Stretch="Uniform"/>
                  <Ellipse Grid.Column="1" Width="12" Height="12" VerticalAlignment="Center" Fill="{Binding StatusBrush}"/>
                  <StackPanel Grid.Column="2" Margin="8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Map}" Classes="muted" FontSize="11"/>
                      <TextBlock Text="{Binding BestElement}" Foreground="#7CC4FF" FontSize="11"/>
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center" FontFamily="Consolas,monospace"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
