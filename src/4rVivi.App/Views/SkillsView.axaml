<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:FourRVivi.App.ViewModels" xmlns:ctrl="clr-namespace:FourRVivi.App.Controls"
             x:Class="FourRVivi.App.Views.SkillsView" x:DataType="vm:SkillsViewModel">
  <StackPanel Spacing="14">
    <TextBlock Text="Skills" Classes="h1"/>
      <ToggleSwitch Content="Skills ON" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Text="Spammer" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Spacing="14">
          <StackPanel><TextBlock Text="Key" Classes="muted"/><ctrl:KeyCaptureBox Width="70" KeyText="{Binding SpamKey}"/></StackPanel>
          <StackPanel><TextBlock Text="Delay ms" Classes="muted"/><NumericUpDown MinWidth="120" Minimum="20" Maximum="10000" Value="{Binding SpamDelay}"/></StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Text="Rotation (Switcher / Songs)" FontWeight="SemiBold"/>
        <TextBlock Classes="muted" Text="Click Record, press each key in order, then click again to stop."/>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Width="260" MinHeight="32" VerticalAlignment="Center" Text="{Binding RotationKeys}" TextWrapping="Wrap"/>
          <ctrl:SequenceRecorder Sequence="{Binding RotationKeys}"/>
          <Button Content="Apply rotation" Command="{Binding ApplyRotationCommand}"/>
        </StackPanel>
        <TextBlock Classes="muted" Text="{Binding Status}"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
