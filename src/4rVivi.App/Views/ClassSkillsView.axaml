<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FourRVivi.App.ViewModels"
             xmlns:ctrl="clr-namespace:FourRVivi.App.Controls"
             x:Class="FourRVivi.App.Views.ClassSkillsView" x:DataType="vm:ClassSkillsViewModel" x:Name="Root">
  <Grid RowDefinitions="Auto,Auto,*">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
      <TextBlock Text="Skill spammer" Classes="h1"/>
      <ToggleSwitch Content="Spam ON" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
      <ComboBox Width="200" ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}" VerticalAlignment="Center"/>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="Delay ms" Classes="muted"/><NumericUpDown MinWidth="110" Minimum="50" Maximum="5000" Value="{Binding SpamDelay}"/></StackPanel>
    </StackPanel>
    <TextBlock Grid.Row="1" Classes="muted" Text="{Binding Status}" Margin="0,8"/>
    <ScrollViewer Grid.Row="2">
      <ItemsControl ItemsSource="{Binding Skills}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ClassSkillRow">
            <Border Classes="card" Width="196" Margin="0,0,8,8" Padding="10">
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Image Source="{Binding Icon}" Width="24" Height="24"/>
                  <StackPanel Width="144">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Aegis}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox Content="Spam" IsChecked="{Binding Enabled}"/>
                  <ctrl:KeyCaptureBox Width="64" KeyText="{Binding Key}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
