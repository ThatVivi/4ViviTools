<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FourRVivi.App.ViewModels"
             xmlns:ctrl="clr-namespace:FourRVivi.App.Controls"
             x:Class="FourRVivi.App.Views.FourRToolsShellView"
             x:DataType="vm:FourRToolsShellViewModel">

  <!-- Faithful 4RTools layout, dark by default to match the app. -->
  <ThemeVariantScope RequestedThemeVariant="Dark">
  <Border Background="Transparent" Padding="0">
    <Grid RowDefinitions="Auto,Auto,*" Margin="0">

      <!-- Title bar -->
      <Border Grid.Row="0" Background="#2D2D30" Padding="12,8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="4ROTools — built-in (OCR-powered)" Foreground="White"
                     FontFamily="Microsoft Sans Serif" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
          <ToggleSwitch Grid.Column="1" OnContent="Tool ON" OffContent="Tool OFF"
                        IsChecked="{Binding ToolEnabled}" Foreground="White"/>
        </Grid>
      </Border>

      <!-- OCR header (replaces memory addresses) -->
      <Border Grid.Row="1" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
        <StackPanel Orientation="Horizontal" Spacing="20">
          <TextBlock Text="{Binding OcrState}" FontFamily="Microsoft Sans Serif" Foreground="#5EC26A" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding CharName, StringFormat='Name: {0}'}" FontFamily="Microsoft Sans Serif" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding HpText, StringFormat='HP: {0}'}" FontFamily="Microsoft Sans Serif" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding SpText, StringFormat='SP: {0}'}" FontFamily="Microsoft Sans Serif" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- Tabs (the original 4RTools tab set) -->
      <TabControl Grid.Row="2" Margin="6" FontFamily="Microsoft Sans Serif">

        <TabItem Header="Autopot">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10" Spacing="8">
              <ToggleSwitch Content="Autopot ON" IsChecked="{Binding Autopot.Enabled}"/>
              <TextBlock Text="Each row = one potion rule. Triggers off the OCR HP/SP read (flat or %)." Foreground="#AAAAAA"/>
              <Button Content="+ Add pot rule" Command="{Binding Autopot.AddPotCommand}" HorizontalAlignment="Left"/>
              <ItemsControl ItemsSource="{Binding Autopot.Pots}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PotRowViewModel">
                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,6">
                      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <CheckBox Content="On" IsChecked="{Binding Enabled}"/>
                        <StackPanel><TextBlock Text="Key" Foreground="#AAAAAA" FontSize="11"/><ctrl:KeyCaptureBox Width="60" KeyText="{Binding Key}"/></StackPanel>
                        <CheckBox Content="SP pot" IsChecked="{Binding UseSp}" VerticalAlignment="Center"/>
                        <StackPanel><TextBlock Text="% threshold" Foreground="#AAAAAA" FontSize="11"/><NumericUpDown MinWidth="110" Minimum="0" Maximum="100" Value="{Binding Percent}"/></StackPanel>
                        
                        <StackPanel><TextBlock Text="Delay ms (-1 auto)" Foreground="#AAAAAA" FontSize="11"/><NumericUpDown MinWidth="110" Minimum="-1" Maximum="9999" Value="{Binding UseDelayMs}"/></StackPanel>
                        <Button Content="✕"
                                Command="{ReflectionBinding DataContext.Autopot.RemovePotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Autobuff - Skills">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10" Spacing="8">
              <ToggleSwitch Content="Buffs ON" IsChecked="{Binding Buffs.Enabled}"/>
              <Button Content="+ Add skill buff" Command="{Binding Buffs.AddSkillBuffCommand}" HorizontalAlignment="Left"/>
              <ItemsControl ItemsSource="{Binding Buffs.SkillBuffs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BuffRowViewModel">
                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,6">
                      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <CheckBox Content="On" IsChecked="{Binding Enabled}"/>
                        <Image Width="24" Height="24" Source="{Binding Name, Converter={StaticResource SkillNameToIcon}}"/>
                        <ctrl:SearchPicker Width="200" Text="{Binding Name}"
                                           ItemsSource="{ReflectionBinding DataContext.Buffs.SkillNames, RelativeSource={RelativeSource AncestorType=UserControl}}" Watermark="search buff skill…"/>
                        <StackPanel><TextBlock Text="Key" Foreground="#AAAAAA" FontSize="11"/><ctrl:KeyCaptureBox Width="60" KeyText="{Binding Key}"/></StackPanel>
                        <StackPanel><TextBlock Text="Recast ms" Foreground="#AAAAAA" FontSize="11"/><NumericUpDown MinWidth="120" Minimum="100" Maximum="600000" Increment="500" Value="{Binding IntervalMs}"/></StackPanel>
                        <Button Content="✕"
                                Command="{ReflectionBinding DataContext.Buffs.RemoveSkillBuffCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Autobuff - Stuffs">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10" Spacing="8">
              <ToggleSwitch Content="Buffs ON" IsChecked="{Binding Buffs.Enabled}"/>
              <Button Content="+ Add item buff" Command="{Binding Buffs.AddItemBuffCommand}" HorizontalAlignment="Left"/>
              <ItemsControl ItemsSource="{Binding Buffs.ItemBuffs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BuffRowViewModel">
                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,6">
                      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <CheckBox Content="On" IsChecked="{Binding Enabled}"/>
                        <Image Width="24" Height="24" Source="{Binding Name, Converter={StaticResource NameToIcon}}"/>
                        <ctrl:SearchPicker Width="200" Text="{Binding Name}"
                                           ItemsSource="{ReflectionBinding DataContext.Buffs.ItemNames, RelativeSource={RelativeSource AncestorType=UserControl}}" Watermark="search buff item…"/>
                        <StackPanel><TextBlock Text="Key" Foreground="#AAAAAA" FontSize="11"/><ctrl:KeyCaptureBox Width="60" KeyText="{Binding Key}"/></StackPanel>
                        <StackPanel><TextBlock Text="Recast ms" Foreground="#AAAAAA" FontSize="11"/><NumericUpDown MinWidth="120" Minimum="100" Maximum="600000" Increment="500" Value="{Binding IntervalMs}"/></StackPanel>
                        <Button Content="✕"
                                Command="{ReflectionBinding DataContext.Buffs.RemoveItemBuffCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Skill Spammer">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10" Spacing="10">
              <ToggleSwitch Content="Spam ON" IsChecked="{Binding SpamGrid.Enabled}"/>
              <!-- Key grid: tick the keys to spam (faithful to 4RTools) -->
              <ItemsControl ItemsSource="{Binding SpamGrid.Keys}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="9"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SpamKey">
                    <CheckBox Content="{Binding Key}" IsChecked="{Binding Enabled}" Margin="2" MinWidth="44"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid ColumnDefinitions="*,*,Auto" Margin="0,6,0,0">
                <!-- Example (click mode) -->
                <Border Grid.Column="0" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,8,0">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Example (click mode)" Foreground="#8BE9FD" FontWeight="Bold"/>
                    <ComboBox ItemsSource="{Binding SpamGrid.ClickModes}" SelectedItem="{Binding SpamGrid.ClickMode}"/>
                  </StackPanel>
                </Border>
                <!-- AHK Configuration -->
                <Border Grid.Column="1" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,8,0">
                  <StackPanel Spacing="4">
                    <TextBlock Text="AHK Configuration" Foreground="#8BE9FD" FontWeight="Bold"/>
                    <ComboBox ItemsSource="{Binding SpamGrid.AhkModes}" SelectedItem="{Binding SpamGrid.AhkMode}"/>
                    <CheckBox Content="Mouse Flick" IsChecked="{Binding SpamGrid.MouseFlick}"/>
                    <CheckBox Content="No Shift" IsChecked="{Binding SpamGrid.NoShift}"/>
                  </StackPanel>
                </Border>
                <!-- Spammer Delay -->
                <Border Grid.Column="2" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Spammer Delay" Foreground="#8BE9FD" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <NumericUpDown MinWidth="110" Minimum="10" Maximum="5000" Value="{Binding SpamGrid.SpammerDelay}"/>
                      <TextBlock Text="ms" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="ATK x DEF Mode">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12" Spacing="10">
              <ToggleSwitch Content="ATK/DEF ON" IsChecked="{Binding AtkDef.Enabled}"/>
              <TextBlock Text="Switches between an ATK equip-set key and a DEF equip-set key, and hammers the spammer key while in ATK stance. Toggle stance below. Fed by OCR/attach." Foreground="#AAAAAA" TextWrapping="Wrap"/>
              <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10">
                <StackPanel Spacing="10">
                  <TextBlock Text="Configuration" FontWeight="Bold" Foreground="#8BE9FD"/>
                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel><TextBlock Text="ATK Switch" Foreground="#AAAAAA" FontSize="11"/><ctrl:KeyCaptureBox Width="70" KeyText="{Binding AtkDef.AtkSwitchKey}"/></StackPanel>
                    <StackPanel><TextBlock Text="DEF Switch" Foreground="#AAAAAA" FontSize="11"/><ctrl:KeyCaptureBox Width="70" KeyText="{Binding AtkDef.DefSwitchKey}"/></StackPanel>
                    <StackPanel><TextBlock Text="Switch Delay (ms)" Foreground="#AAAAAA" FontSize="11"/><NumericUpDown MinWidth="110" Minimum="0" Maximum="9999" Value="{Binding AtkDef.SwitchDelay}"/></StackPanel>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel><TextBlock Text="Spammer Key" Foreground="#AAAAAA" FontSize="11"/><ctrl:KeyCaptureBox Width="70" KeyText="{Binding AtkDef.SpammerKey}"/></StackPanel>
                    <StackPanel><TextBlock Text="Spammer Delay (ms)" Foreground="#AAAAAA" FontSize="11"/><NumericUpDown MinWidth="110" Minimum="50" Maximum="5000" Value="{Binding AtkDef.SpammerDelay}"/></StackPanel>
                    <CheckBox Content="With mouse click" IsChecked="{Binding AtkDef.WithMouseClick}" VerticalAlignment="Bottom"/>
                  </StackPanel>
                  <ToggleSwitch OnContent="Stance: ATK (spamming)" OffContent="Stance: DEF (guarding)" IsChecked="{Binding AtkDef.AtkMode}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Macro Switch">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12" Spacing="10">
              <ToggleSwitch Content="Macros ON" IsChecked="{Binding Macros.Enabled}"/>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="+ Add chain" Command="{Binding Macros.AddChainCommand}"/>
                <StackPanel><TextBlock Text="Gap ms" Foreground="#AAAAAA" FontSize="11"/><NumericUpDown MinWidth="110" Minimum="0" Maximum="9999" Value="{Binding Macros.GapMs}"/></StackPanel>
              </StackPanel>
              <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Height="300">
                <ListBox ItemsSource="{Binding Macros.Chains}" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MacroRowViewModel">
                      <Grid ColumnDefinitions="150,*,110,Auto,Auto,Auto" Margin="2">
                        <TextBox Grid.Column="0" Text="{Binding Name}" Watermark="name" Margin="0,0,6,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,6,0">
                          <TextBlock Width="180" MinHeight="28" VerticalAlignment="Center" Text="{Binding KeysCsv}" TextWrapping="Wrap"/>
                          <ctrl:SequenceRecorder Sequence="{Binding KeysCsv}"/>
                        </StackPanel>
                        <NumericUpDown Grid.Column="2" Minimum="0" Maximum="600000" Value="{Binding IntervalMs}" Margin="0,0,6,0"/>
                        <CheckBox Grid.Column="3" Content="Loop" IsChecked="{Binding LoopWhileOn}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Grid.Column="4" Content="Play"
                                Command="{ReflectionBinding DataContext.Macros.PlayChainCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,6,0"/>
                        <Button Grid.Column="5" Content="X"
                                Command="{ReflectionBinding DataContext.Macros.RemoveChainCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
              <TextBlock Text="{Binding Macros.Status}" Foreground="#AAAAAA" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Macro Songs">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12" Spacing="10">
              <ToggleSwitch Content="Macros ON" IsChecked="{Binding Macros.Enabled}"/>
              <TextBlock Text="Ensemble / song chains. Enter the song key sequence; each chain loops while the tool is ON." Foreground="#AAAAAA" TextWrapping="Wrap"/>
              <StackPanel><TextBlock Text="Song sequence (CSV)" Foreground="#AAAAAA" FontSize="11"/>
                <TextBox Width="320" Text="{Binding Macros.Sequence}"/></StackPanel>
              <Button Content="+ Add as chain" Command="{Binding Macros.AddChainCommand}" HorizontalAlignment="Left"/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Skill timers">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12" Spacing="10">
              <ToggleSwitch Content="Recast ON" IsChecked="{Binding Buffs.Enabled}"/>
              <TextBlock Text="Each row recasts a skill key on its own timer (cooldown tracker)." Foreground="#AAAAAA" TextWrapping="Wrap"/>
              <Button Content="+ Add timer" Command="{Binding Buffs.AddSkillBuffCommand}" HorizontalAlignment="Left"/>
              <ItemsControl ItemsSource="{Binding Buffs.SkillBuffs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BuffRowViewModel">
                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,6">
                      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <CheckBox Content="On" IsChecked="{Binding Enabled}"/>
                        <StackPanel><TextBlock Text="Key" Foreground="#AAAAAA" FontSize="11"/><ctrl:KeyCaptureBox Width="60" KeyText="{Binding Key}"/></StackPanel>
                        <StackPanel><TextBlock Text="Recast ms" Foreground="#AAAAAA" FontSize="11"/><NumericUpDown MinWidth="120" Minimum="100" Maximum="600000" Increment="500" Value="{Binding IntervalMs}"/></StackPanel>
                        <Button Content="✕"
                                Command="{ReflectionBinding DataContext.Buffs.RemoveSkillBuffCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Debuff">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12" Spacing="10">
              <!-- Status Effects group: cure items on timer -->
              <TextBlock Text="Status Effects" FontWeight="Bold" Foreground="#8BE9FD"/>
              <ToggleSwitch Content="Auto-cure ON" IsChecked="{Binding Buffs.Enabled}"/>
              <TextBlock Text="Cure items used on a timer to clear debuffs (Panacea, Green Potion, etc.)." Foreground="#AAAAAA" TextWrapping="Wrap"/>
              <Button Content="+ Add cure item" Command="{Binding Buffs.AddItemBuffCommand}" HorizontalAlignment="Left"/>
              <ItemsControl ItemsSource="{Binding Buffs.ItemBuffs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BuffRowViewModel">
                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,6">
                      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <CheckBox Content="On" IsChecked="{Binding Enabled}"/>
                        <StackPanel><TextBlock Text="Key" Foreground="#AAAAAA" FontSize="11"/><ctrl:KeyCaptureBox Width="60" KeyText="{Binding Key}"/></StackPanel>
                        <StackPanel><TextBlock Text="Recast ms" Foreground="#AAAAAA" FontSize="11"/><NumericUpDown MinWidth="120" Minimum="100" Maximum="600000" Increment="500" Value="{Binding IntervalMs}"/></StackPanel>
                        <Button Content="✕"
                                Command="{ReflectionBinding DataContext.Buffs.RemoveItemBuffCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Status Recovery group: Auto Stand (OCR-driven) -->
              <TextBlock Text="Status Recovery" FontWeight="Bold" Foreground="#8BE9FD" Margin="0,10,0,0"/>
              <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10">
                <StackPanel Spacing="8">
                  <ToggleSwitch Content="Enable Auto Stand (when forced to sit)" IsChecked="{Binding AutoStand.Enabled}"/>
                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel><TextBlock Text="Stand key" Foreground="#AAAAAA" FontSize="11"/><ctrl:KeyCaptureBox Width="70" KeyText="{Binding AutoStand.StandKey}"/></StackPanel>
                    <StackPanel><TextBlock Text="Cooldown (ms)" Foreground="#AAAAAA" FontSize="11"/><NumericUpDown MinWidth="110" Minimum="500" Maximum="60000" Value="{Binding AutoStand.CooldownMs}"/></StackPanel>
                  </StackPanel>
                  <TextBlock Text="Detection: add an OCR text box (role &quot;Posture&quot; or &quot;State&quot;) over the sit indicator — it stands when that reads &quot;sit&quot;. Or enable motion-dwell below (uses the character-motion box)." Foreground="#AAAAAA" TextWrapping="Wrap" FontSize="11"/>
                  <CheckBox Content="Also stand on motion-dwell (advanced - may mis-trigger on idle)" IsChecked="{Binding AutoStand.UseMotion}"/>
                  <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding AutoStand.UseMotion}">
                    <StackPanel><TextBlock Text="Motion threshold" Foreground="#AAAAAA" FontSize="11"/><NumericUpDown MinWidth="110" Minimum="0" Maximum="100" Value="{Binding AutoStand.MotionThreshold}"/></StackPanel>
                    <StackPanel><TextBlock Text="Dwell (ms)" Foreground="#AAAAAA" FontSize="11"/><NumericUpDown MinWidth="110" Minimum="250" Maximum="60000" Value="{Binding AutoStand.DwellMs}"/></StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </Border>
  </ThemeVariantScope>
</UserControl>
